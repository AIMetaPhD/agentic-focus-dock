{
  "name": "agentic-focus-dock",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, AI-native focus dock with customizable modes and an optional macOS companion.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "npm run build && tsx server/src/index.ts",
    "build": "npm run build --workspace web",
    "start": "npm run build && tsx server/src/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:server && npm run test:web",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test:web": "vitest run --config web/vitest.config.ts",
    "test:e2e": "playwright test",
    "secret-scan": "node scripts/secret-scan.mjs",
    "verify": "npm run secret-scan && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
